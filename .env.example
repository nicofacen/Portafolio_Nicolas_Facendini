# URL de la función serverless de Vercel que atiende al chatbot (api/chat.js).
# Debe ir con el prefijo PUBLIC_ para que Astro la exponga en el cliente.
# En Vercel alcanza con la ruta relativa: /api/chat
PUBLIC_CHATBOT_API_URL=https://tu-proyecto.vercel.app/api/chat

# Clave del formulario de contacto (web3forms.com): ingresás tu correo, te la mandan por mail.
# Es pública por diseño (va en el navegador); los mensajes llegan al correo con el que la pediste.
PUBLIC_WEB3FORMS_KEY=
