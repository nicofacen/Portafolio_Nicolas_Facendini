---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import MenuTabs from "@components/MenuTabs.jsx";
import PanelSwitcher from "@components/side_menu/PanelSwicher";
import ChatBot from "@components/shared/ChatBot.jsx";
import { ClientRouter, ViewTransitions } from 'astro:transitions';

import "@styles/global.css";

interface Props {
  pageName?: string;
}

const { pageName = "About me" } = Astro.props;

const title = "Portafolio - Nicolas Facendini";
const description =
	"Portafolio de Nicolas Facendini, estudiante de Gestión de la Tecnología de la Información (UADE) orientado al desarrollo web. Proyectos, habilidades y contacto.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImage = new URL("/profile_photos/Nicolas_Facendini2.jpg", Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Nicolas Facendini" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={title} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={previewImage} />
		<meta property="og:image:alt" content="Foto de Nicolas Facendini" />
		<meta property="og:locale" content="es_AR" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={previewImage} />
		<script is:inline>
			try {
				if (localStorage.getItem("lang") === "en") {
					document.documentElement.lang = "en";
					document.documentElement.classList.add("i18n-pending");
				}
			} catch {}
		</script>
		<ClientRouter />
	</head>
	<body class="min-h-screen flex flex-col bg-main text-primaryText overflow-hidden">
		<Header />

		<main class="flex-1 flex flex-col min-h-0">
			<div class="flex w-full h-full flex-1 min-h-0 overflow-hidden">
				<PanelSwitcher client:load />
				<div
					class="flex flex-col flex-1 w-full h-full min-h-0 overflow-y-auto bg-secondary scrollbar-hidden"
				>
					<div class="sticky top-0 z-40">
						<MenuTabs client:load currentPage={pageName} />
					</div>
					<slot />
				</div>
			</div>
			<ChatBot client:load />
		</main>

		<Footer class="fixed bottom-0 left-0 w-full z-50" />
	</body>
</html>

<script>
	import { restoreLang, setLang } from "@i18n/lang.js";

	restoreLang();
	// ClientRouter reemplaza el <html> al navegar, así que hay que volver a aplicar el idioma.
	document.addEventListener("astro:after-swap", restoreLang);
	document.addEventListener("click", (event) => {
		const option = event.target instanceof Element && event.target.closest("[data-lang-option]");
		if (option) setLang(option.getAttribute("data-lang-option"));
	});
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		
	}
	.scrollbar-hidden {
		scrollbar-width: none;
	}
	.scrollbar-hidden::-webkit-scrollbar {
		display: none;
	}
</style>
