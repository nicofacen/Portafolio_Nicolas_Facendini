---
import LayoutContent from "@components/LayoutContent.astro";
import CardProyect from "@components/about_me/CardProyect.astro";
import { projects, projectId } from "@data/projects.js";
---

<LayoutContent
  id="proyectos"
  titleKey="projects.title"
  descriptionKey="projects.description"
>
  <div class="projects-wrap">
    <div class="projects-grid">
      {
        projects.map((project) => (
          <CardProyect
            id={projectId(project)}
            title={project.title}
            description={project.description}
            descriptionEn={project.descriptionEn}
            image={project.image}
            linkExternal={project.linkExternal}
            technologies={project.technologies}
            finish={project.finish}
          />
        ))
      }
    </div>
  </div>
</LayoutContent>

<style>
  /* Dos columnas solo si el contenido tiene lugar: con el panel lateral abierto
     una ventana ancha puede dejar poco espacio. */
  .projects-wrap {
    container-type: inline-size;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @container (min-width: 44rem) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
