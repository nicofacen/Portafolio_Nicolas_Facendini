---
import LayoutContent from "@components/LayoutContent.astro";
import { experience } from "@data/experience.js";

// Un texto puede venir como string (igual en ambos idiomas) o como { es, en }.
const text = (value) => (typeof value === "string" ? { es: value, en: value } : value);
---

<LayoutContent id="experiencia" titleKey="experience.title" descriptionKey="experience.description">
  <ol class="ml-2 space-y-10 border-l border-white/10">
    {
      experience.map((item) => {
        const label = text(item.period ?? item.kind);
        const title = text(item.title);
        const org = item.org ? text(item.org) : null;
        const description = text(item.description);

        return (
          <li class="relative pl-8">
            <span
              class="absolute -left-[6px] top-2 h-3 w-3 rounded-full bg-accent ring-4 ring-secondary"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <h3 class="text-lg font-bold" data-lang-es={title.es} data-lang-en={title.en}>
                {title.es}
              </h3>
              <span
                class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-xs font-semibold text-accent"
                data-lang-es={label.es}
                data-lang-en={label.en}
              >
                {label.es}
              </span>
            </div>
            {org && (
              <p class="mt-1 text-sm font-medium text-primaryText/70" data-lang-es={org.es} data-lang-en={org.en}>
                {org.es}
              </p>
            )}
            <p
              class="mt-3 max-w-3xl text-base leading-relaxed text-primaryText/90"
              data-lang-es={description.es}
              data-lang-en={description.en}
            >
              {description.es}
            </p>
            {item.tags?.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {item.tags.map((tag) => {
                  const chip = text(tag);
                  return (
                    <li
                      class="rounded-md border border-accent/30 bg-skillColor/60 px-2.5 py-1 font-mono text-xs text-accent"
                      data-lang-es={chip.es}
                      data-lang-en={chip.en}
                    >
                      {chip.es}
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })
    }
  </ol>
</LayoutContent>
