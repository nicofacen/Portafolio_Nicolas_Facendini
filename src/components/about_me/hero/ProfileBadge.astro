---
import { t } from "@i18n/lang.js";
---
<div class="flex flex-row gap-5 items-center">
    <img
        src="/profile_photos/Nicolas_Facendini2.jpg"
        alt="Nicolas Facendini"
        loading="lazy"
        decoding="async"
        class="w-24 h-24 rounded-full object-cover"
    />
    <div class="flex items-center h-max">
        <span class="relative inline-flex overflow-hidden rounded-full p-[1.5px]">
            <span
                class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,theme(colors.accent)_0%,theme(colors.accent)_50%,theme(colors.surface)_100%)]"
            ></span>
            <div
                class="inline-flex items-center justify-center w-full px-3 py-1 text-sm text-accent bg-surface rounded-full backdrop-blur-3xl whitespace-nowrap border border-accent/30 shadow-md"
            >
                <span class="text-primaryText tracking-wide text-sm xl:text-base" data-i18n="hero.openToWork"
                    >{t("hero.openToWork", "es")}</span
                >
            </div>
        </span>
    </div>
</div>
