---
import SocialNetworks from '@components/SocialNetworks.astro';
import ProfileBadge from './ProfileBadge.astro';
import TypewriterText from './TypewriterText.astro';
import HeroActions from './HeroActions.astro';
import { t } from '@i18n/lang.js';
---
<div class="max-w-7xl relative h-full flex flex-row gap-10 items-center mx-auto">
    <div class="flex-1 flex flex-col gap-6">
        <ProfileBadge />
        <div class="flex flex-col gap-6">
            <p class="text-3xl @xl:text-4xl">
                <span data-i18n="hero.greeting">{t("hero.greeting", "es")}</span> <strong class="gradient-text text-accent"
                    >Nicolas Martin Facendini</strong
                >
            </p>
            <TypewriterText />
            <p class="leading-relaxed max-w-4xl" data-i18n="hero.bio">
                {t("hero.bio", "es")}
            </p>
            <HeroActions />
        </div>
    </div>
    <div class="hidden md:block">
        <SocialNetworks />
    </div>
</div>
