---
import LayoutContent from "@components/LayoutContent.astro";
import { t } from "@i18n/lang.js";
---

<LayoutContent id="sobre-mi" titleKey="about.title">
  <div class="about-wrap">
    <div class="about-grid">
      <h2
        class="about-tagline max-w-2xl text-2xl font-bold text-primaryText/80 md:text-3xl"
        data-i18n="about.description"
      >
        {t("about.description", "es")}
      </h2>
      <div class="about-text">
        <div class="space-y-1 border-b border-white/10 pb-5">
          <h3 class="text-2xl font-bold">Nicolas Facendini</h3>
          <h4 class="text-base font-medium text-accent" data-i18n="about.role">{t("about.role", "es")}</h4>
        </div>
        <div class="space-y-4 pt-5">
          <p class="text-base leading-relaxed text-primaryText/90" data-i18n="about.p1">
            {t("about.p1", "es")}
          </p>
          <p class="text-base leading-relaxed text-primaryText/90" data-i18n="about.p2">
            {t("about.p2", "es")}
          </p>
        </div>
      </div>
      <img
        class="about-photo rounded-xl border border-white/10 object-cover shadow-md"
        src="/profile_photos/Nicolas_Facendini1.jpg"
        alt="Foto Nicolas Facendini"
      />
    </div>
  </div>
</LayoutContent>

<style>
  /* El diseño depende del ancho del contenido y no de la ventana: con el panel
     lateral abierto, una ventana ancha puede dejar muy poco lugar al texto. */
  .about-wrap {
    container-type: inline-size;
  }

  .about-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-areas:
      "tagline"
      "photo"
      "text";
  }

  .about-tagline {
    grid-area: tagline;
  }

  .about-text {
    grid-area: text;
    max-width: 48rem;
  }

  .about-photo {
    grid-area: photo;
    width: 11rem;
    height: 11rem;
  }

  @container (min-width: 44rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "tagline photo"
        "text photo";
      column-gap: 3rem;
      align-items: start;
    }

    .about-photo {
      width: 18rem;
      height: 18rem;
      justify-self: end;
    }
  }
</style>
