---
import LayoutContent from "@components/LayoutContent.astro";
import { t } from "@i18n/lang.js";
---

<LayoutContent
  id="sobre-mi"
  titleKey="about.title"
  descriptionKey="about.description"
>
  <div
    class="flex flex-col-reverse md:flex-row gap-6 md:gap-10 items-center md:items-start"
  >
    <div class="space-y-4 w-full md:w-2/3">
      <h3 class="text-lg font-semibold">Nicolas Facendini</h3>
      <h4 class="text-base text-accent font-medium" data-i18n="about.role">{t("about.role", "es")}</h4>
      <p class="text-base leading-relaxed" data-i18n="about.p1">
        {t("about.p1", "es")}
      </p>
      <p class="text-base leading-relaxed" data-i18n="about.p2">
        {t("about.p2", "es")}
      </p>
    </div>
    <img
      class="w-44 h-44 md:w-72 md:h-72 object-cover rounded-lg shadow-md"
      src="/profile_photos/Nicolas_Facendini1.jpg"
      alt="Foto Nicolas Facendini"
    />
  </div>
</LayoutContent>
