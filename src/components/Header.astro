---
import Cerrar from "@components/icons/Cerrar.astro";
import Maximizar from "@components/icons/Maximizar.astro";
import Minimizar from "@components/icons/Minimizar.astro";
import { t } from "@i18n/lang.js";
const items: { title: string; href?: string }[] = [
  { title: "File" },
  { title: "Edit" },
  { title: "Selection"},
  { title: "View"},
  { title: "Go"},
  { title: "Run"},
  { title: "Help"},
];
---
<header class="bg-main sticky top-0 z-50 text-primaryText h-12">
  <!-- Logo fijo a la izquierda, centrado verticalmente -->
  <a
    class="absolute top-1/2 left-4 -translate-y-1/2 cursor-pointer"
    href="https://code.visualstudio.com/docs"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="VSCode Docs"
  >
    <img
      src="/visualLogo.webp"
      alt="Logo"
      class="w-6 h-6 object-contain hover:scale-105 transition-transform"
    />
  </a>
  <div class="ml-14 flex justify-between items-center h-full">
    <!-- Menú completo en pantallas anchas -->
    <nav class="hidden md:block">
      <ul class="flex gap-2 text-sm">
        {items.map(({ title, href }) => (
          <li>
            <a
              class="hover:bg-gray-700 rounded px-3 py-1 transition-colors duration-200"
              href={href ?? '#'}
            >
              {title}
            </a>
          </li>
        ))}

      </ul>
    </nav>

    <!-- Centrado respecto de toda la barra (no del espacio sobrante entre el menú y los controles) -->
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 whitespace-nowrap text-sm font-medium min-[1120px]:block"
      data-i18n="header.subtitle"
    >
      {t("header.subtitle", "es")}
    </div>
    <div class="ml-auto md:ml-0 flex gap-5 items-center">
      <!-- En pantallas chicas el mismo menú se colapsa en una hamburguesa, junto al selector de idioma -->
      <div class="relative -mr-3 md:hidden" data-header-menu>
        <button
          type="button"
          data-header-menu-button
          aria-label="Menú"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="header-menu-list"
          class="flex h-8 w-8 items-center justify-center rounded-md text-primaryText transition-colors hover:bg-gray-700 data-[open=true]:bg-gray-700"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <ul
          id="header-menu-list"
          role="menu"
          hidden
          class="absolute right-0 top-10 z-50 min-w-40 rounded-md border border-white/10 bg-secondary py-1.5 text-sm shadow-2xl"
        >
          {items.map(({ title, href }) => (
            <li role="none">
              <a
                role="menuitem"
                href={href ?? '#'}
                class="block px-4 py-1.5 text-primaryText transition-colors hover:bg-accent/15 hover:text-accent"
              >
                {title}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div
        role="group"
        aria-label="Idioma / Language"
        class="flex h-7 items-stretch overflow-hidden rounded-md border border-white/10 bg-secondary text-xs font-semibold tracking-wider"
      >
        <button
          type="button"
          data-lang-option="es"
          data-active="true"
          aria-pressed="true"
          title="Español"
          class="flex items-center px-2.5 text-primaryText/50 transition-colors hover:bg-white/5 hover:text-primaryText data-[active=true]:bg-accent/15 data-[active=true]:text-accent"
        >ES</button>
        <button
          type="button"
          data-lang-option="en"
          data-active="false"
          aria-pressed="false"
          title="English"
          class="flex items-center border-l border-white/10 px-2.5 text-primaryText/50 transition-colors hover:bg-white/5 hover:text-primaryText data-[active=true]:bg-accent/15 data-[active=true]:text-accent"
        >EN</button>
      </div>
    <div class="flex flex-row h-full items-stretch">
        <div
          class="w-[3rem] h-[3rem] hover:bg-gray-700 hidden sm:flex justify-center items-center transition-[background] duration-200 ease-linear"
        >
          <Minimizar class="" />
        </div>

        <div
          class="w-[3rem] h-[3rem] hover:bg-gray-700 hidden sm:flex justify-center items-center transition-[background] duration-200 ease-linear"
        >
          <Maximizar class="" />
        </div>

        <div
          class="w-[3rem] h-[3rem] hover:bg-red-600 group flex justify-center items-center transition-[background] duration-200 ease-linear"
        >
          <Cerrar class="group-hover:text-white" />
        </div>
      </div>

    </div>

  </div>

</header>

<script>
  // Delegado en document: sigue funcionando aunque el ClientRouter reemplace el header al navegar.
  function setMenuOpen(open: boolean) {
    const button = document.querySelector<HTMLElement>("[data-header-menu-button]");
    const list = document.getElementById("header-menu-list");
    if (!button || !list) return;
    list.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("data-open", String(open));
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest("[data-header-menu-button]")) {
      const list = document.getElementById("header-menu-list");
      setMenuOpen(list?.hidden ?? false);
    } else if (!target.closest("#header-menu-list") || target.closest("a")) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  document.addEventListener("astro:after-swap", () => setMenuOpen(false));
</script>
