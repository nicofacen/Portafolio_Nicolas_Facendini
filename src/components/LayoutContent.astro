---
import { t } from "@i18n/lang.js";

const { titleKey, descriptionKey, id } = Astro.props;
---
<section id={id} class=" py-10 mb-10 mx-auto max-w-7xl space-y-6">
    <div class="relative before:absolute after:absolute before:bg-white
    after:bg-gray-500/30 before:left-0 before:top-0 before:h-[1.5px]
    before:w-6 after:left-8 after:right-0 after:top-0 after:h-[1.5px]"></div>

    <h1 class="text-lg md:text-xl font-bold text-accent" data-i18n={titleKey}>{t(titleKey, "es")}</h1>
    {descriptionKey && <h2 class="text-2xl md:text-3xl font-bold max-w-2xl text-primaryText/80" data-i18n={descriptionKey}>{t(descriptionKey, "es")}</h2>}

  </header>
  <section class="space-y-4">
    <slot />
  </section>
</section>
