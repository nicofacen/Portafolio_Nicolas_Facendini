---
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";
---
<ul
  class="flex w-fit flex-row xl:flex-col justify-center self-center border-[1px] border-[#4b556380] py-3 xl:py-4 px-4 xl:px-3 bg-main rounded-[40px] gap-6"
>
  <li class="flex items-center justify-center bg-main outline-none border-none rounded-full cursor-pointer" data-tooltip="Linkedin" data-flow="left">
    <a href="https://www.linkedin.com/in/nicolas-facendini-b1a932297/" target="_blank" rel="noopener noreferrer" aria-label="Linkedin link" class="size-full p-2 hover:bg-secondary transition-all duration-200 ease-linear rounded-full">
      <LinkedinIcon class="w-5 h-5 xl:w-7 xl:h-7" />
    </a>
  </li>
  <li class="flex items-center justify-center bg-main outline-none border-none rounded-full cursor-pointer" data-tooltip="Github" data-flow="left">
    <a href="https://github.com/nicofacen" target="_blank" rel="noopener noreferrer" aria-label="Github link" class="size-full p-2 hover:bg-secondary transition-all duration-200 ease-linear rounded-full">
      <GithubIcon class="w-5 h-5 xl:w-7 xl:h-7" />
    </a>
  </li>
  <li class="flex items-center justify-center bg-main outline-none border-none rounded-full cursor-pointer" data-tooltip="Whatsapp" data-flow="left">
    <a href="https://wa.me/5491126677196?text=Hola%20Nicolas%2C%20te%20contacto%20desde%20tu%20portafolio" target="_blank" rel="noopener noreferrer" aria-label="Whatsapp link" class="size-full p-2 hover:bg-secondary transition-all duration-200 ease-linear rounded-full">
      <WhatsappIcon class="w-5 h-5 xl:w-7 xl:h-7" />
    </a>
  </li>
</ul>